# Copy this file to .env on the server and fill in the MySQL login.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=library_app
DB_PASSWORD=change-me
DB_NAME=technical_library

# Address the apps connect to: http://76.13.198.196:4000
HOST=0.0.0.0
PORT=4000

# Library's local time zone: decides "today", due dates and overdue days.
TZ=Asia/Kolkata

# Signed-in sessions end after this many hours without use.
SESSION_HOURS=12
