{
  "name": "ota-campus-library",
  "productName": "2CQR GARUDA",
  "version": "1.0.0",
  "description": "2CQR GARUDA — CGAS Chennai",
  "main": "main.js",
  "author": "2CQR",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js",
    "dist": "node scripts/build-technical.js",
    "dist:general": "node scripts/build-general.js",
    "dist:all": "node scripts/build-all.js",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.otacampus.library",
    "productName": "2CQR GARUDA",
    "executableName": "CGAS",
    "copyright": "© 2026 2CQR",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "server/api.js",
      "server/library-db.js",
      "server/audit.js",
      "db-config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "2CQR GARUDA",
      "artifactName": "2CQR-GARUDA-Manuals Setup ${version}.exe"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.5",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "javascript-obfuscator": "^4.2.2"
  }
}
